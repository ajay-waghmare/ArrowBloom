    <string name="htp_1_title">Tap to escape</string>
    <string name="htp_1_text">Tap an arrow and it flies off the board the way it points — if nothing stands in its way.</string>
    <string name="htp_2_title">Order matters</string>
    <string name="htp_2_text">A blocked arrow shakes and costs a star. Clear what is in front of it first. Long arrows need their whole body free.</string>
