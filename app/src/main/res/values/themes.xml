<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark platform base; Compose draws everything, edge to edge. -->
    <style name="Theme.ArrowBloom" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
    </style>

    <!-- Cold start: the arrow icon on the brand background, then straight into Compose. -->
    <style name="Theme.ArrowBloom.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ArrowBloom</item>
    </style>
</resources>
